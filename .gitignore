# ==========================================
# Godot Engine Core
# ==========================================
# Godot 4.x project cache and local editor state 
.godot/

# Godot 3.x project cache directory
.import/

# Android no-media flag generated by Godot
.nomedia

# Temporary files generated during resource saving
*.tmp

# ==========================================
# Build and Export Artifacts
# ==========================================
# Prevent committing sensitive credentials/signing keys
export_credentials.cfg
export.cfg

# Exclude binary export outputs (add specific extensions if needed)
*.exe
*.dll
*.so
*.dylib
*.apk
*.aab
*.js
*.wasm
*.pck

# ==========================================
# C# / Mono / .NET (If using .NET version)
# ==========================================
.mono/
data_*/
mono_crash.*.json
[Bb]in/
[Oo]bj/
*.sln
*.csproj

# ==========================================
# IDE and System Clutter
# ==========================================
# JetBrains (Rider)
.idea/

# VS Code
.vscode/
!.vscode/tasks.json
!.vscode/launch.json

# OS files
.DS_Store
Thumbs.db

